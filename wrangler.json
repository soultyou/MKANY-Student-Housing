{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mkany",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "NODE_ENV": "production"
  }
}
